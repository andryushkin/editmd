    "%lld open documents live inside this folder. Close them before moving it to the Trash." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld open document lives inside this folder. Close it before moving the folder to the Trash."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld open documents live inside this folder. Close them before moving the folder to the Trash."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Внутри этой папки открыт %lld документ. Закройте его перед перемещением папки в Корзину."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Внутри этой папки открыто %lld документа. Закройте их перед перемещением папки в Корзину."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Внутри этой папки открыто %lld документов. Закройте их перед перемещением папки в Корзину."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Внутри этой папки открыто %lld документа. Закройте их перед перемещением папки в Корзину."
                }
              }
