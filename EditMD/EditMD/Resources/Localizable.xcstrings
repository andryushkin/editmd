    },
    "Moving “%@” to the Trash…" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перемещаем «%@» в Корзину…"
          }
        }
      }
    },
    "Names that start with a dot are hidden files and would disappear from the list." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имена, начинающиеся с точки, — скрытые файлы: они исчезнут из списка."
          }
        }
      }
    },
    "Close the open files inside “%@” first." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала закройте открытые файлы внутри «%@»."
