    },
    "\n\nNo upstream configured — git will report the error if push cannot proceed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nUpstream не настроен — git сообщит об ошибке, если push невозможен."
          }
        }
      }
    },
    "\n\nNothing to push (0 commits ahead of upstream).": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\n\nНечего отправлять (0 коммитов впереди upstream)."
